<Window x:Class="Apitf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="apitf-graph — git for Terraform / OpenAPI"
        Height="760" Width="1200"
        Background="#1E1E2E">
    <DockPanel>

        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="#181825" Padding="8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Base…" Click="LoadBase_Click" Margin="0,0,6,0" Padding="8,3"/>
                    <Button Content="Current (Ours)…" Click="LoadOurs_Click" Margin="0,0,6,0" Padding="8,3"/>
                    <Button Content="Incoming (Theirs)…" Click="LoadTheirs_Click" Margin="0,0,6,0" Padding="8,3"/>
                    <Border Width="1" Background="#45475A" Margin="6,0"/>
                    <Button Content="New scratch" Click="NewScratch_Click" Margin="6,0,0,0" Padding="8,3"/>
                    <Button Content="Merge ▶" Click="Merge_Click" Margin="6,0,0,0" Padding="8,3"/>
                    <Button Content="Apply resolutions ✓" Click="ApplyResolutions_Click" Margin="6,0,0,0" Padding="8,3"/>
                    <Border Width="1" Background="#45475A" Margin="6,0"/>
                    <Button Content="Save spec…" Click="SaveSpec_Click" Margin="6,0,0,0" Padding="8,3"/>
                    <TextBlock Text="Envs:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox x:Name="TxtEnvs" Width="120" Text="dev,prod" VerticalAlignment="Center"/>
                    <Button Content="Generate Terraform…" Click="GenerateTf_Click" Margin="6,0,0,0" Padding="8,3"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Method:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbMethod" Width="86" SelectedIndex="0">
                        <ComboBoxItem>GET</ComboBoxItem>
                        <ComboBoxItem>POST</ComboBoxItem>
                        <ComboBoxItem>PUT</ComboBoxItem>
                        <ComboBoxItem>DELETE</ComboBoxItem>
                        <ComboBoxItem>PATCH</ComboBoxItem>
                    </ComboBox>
                    <TextBlock Text="Path:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox x:Name="TxtPath" Width="220" Text="/orders"/>
                    <TextBlock Text="Summary:" Foreground="#CDD6F4" VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <TextBox x:Name="TxtSummary" Width="200"/>
                    <Button Content="Add method" Click="AddMethod_Click" Margin="10,0,4,0" Padding="8,3"/>
                    <Button Content="Remove method" Click="RemoveMethod_Click" Padding="8,3"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="#11111B" Padding="8,5">
            <TextBlock x:Name="StatusText" Foreground="#A6E3A1"
                       Text="Load Base + Current + Incoming and press Merge, or press New scratch to build from zero."/>
        </Border>

        <!-- Main area: graph + conflicts -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Background="#181825"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="GraphCanvas" Width="2200" Height="1500"/>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Left" Background="#313244"/>

            <DockPanel Grid.Column="1" Margin="8,6,4,6">
                <TextBlock DockPanel.Dock="Top" Text="Conflicts" FontWeight="Bold"
                           Foreground="#F38BA8" FontSize="14" Margin="2,0,0,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ConflictPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
