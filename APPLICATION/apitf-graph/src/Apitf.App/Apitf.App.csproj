<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Apitf.App</RootNamespace>
    <AssemblyName>ApitfGraph</AssemblyName>
    <!-- Allows compiling this WPF (net8.0-windows) project on Linux/macOS CI for verification. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Apitf.Core\Apitf.Core.csproj" />
  </ItemGroup>

</Project>
